{
  "name": "jianwen",
  "version": "0.1.0",
  "description": "Jianwen (见闻): local MCP server that turns media from online platforms (Bilibili, Douyin) into model-readable context - metadata, subtitles, ASR and keyframes",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "jianwen": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "tsc -p tsconfig.test.json && node --import tsx --test \"tests/**/*.test.ts\"",
    "douyin:cookies": "node scripts/douyin-cookies.mjs",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "bilibili",
    "douyin",
    "tiktok",
    "video",
    "media",
    "subtitle",
    "asr",
    "transcript",
    "keyframes",
    "cursor",
    "claude"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "sharp": "^0.35.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
